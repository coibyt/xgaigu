PORT=3000
NODE_ENV=production
# Đổi thành chuỗi ngẫu nhiên dài
SESSION_SECRET=change-me
# Email của quản trị viên (đăng ký bằng email này sẽ có quyền admin)
ADMIN_EMAIL=you@example.com
SITE_URL=https://xgaigu.com
# Thư mục lưu dữ liệu & ảnh/video tải lên (để ngoài thư mục deploy nếu có thể)
DATA_DIR=./data
UPLOAD_DIR=./uploads
