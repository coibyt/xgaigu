PORT=3000
NODE_ENV=production
# Đổi thành chuỗi ngẫu nhiên dài
SESSION_SECRET=change-me
# Email của quản trị viên (đăng ký bằng email này sẽ có quyền admin)
ADMIN_EMAIL=you@example.com
SITE_URL=https://xgaigu.com
# After moving to a new domain: set SITE_URL to the new one and list the old domain(s) here (comma separated).
# Old links and installed apps are then forwarded to the new domain automatically.
LEGACY_HOSTS=
# Thư mục lưu dữ liệu & ảnh/video tải lên (để ngoài thư mục deploy nếu có thể)
DATA_DIR=./data
UPLOAD_DIR=./uploads
